------------\nmodel = Sequential([ LSTM(50, return_sequences=True, input_shape=(X.shape[1], 1)), Dropout(0.2), LSTM(50), Dropout(0.2), Dense(1) ])\n\n\nmodel.compile(optimizer=\"adam\", loss=\"mean_squared_error\")\nhistory = model.fit(X_train, y_train, epochs=20, batch_size=32, validation_split=0.1, verbose=1)\n\n# ------------------------\n# 6. Predictions\n# ------------------------\npreds = model.predict(X_test)\npreds = scaler.inverse_transform(preds.reshape(-1, 1))\ny_test_rescaled = scaler.inverse_transform(y_test.reshape(-1, 1))\n\n# ------------------------\n# 7. Plot results\n# ------------------------\nplt.figure(figsize=(10, 6))\nplt.plot(y_test_rescaled, label=\"True Price\")\nplt.plot(preds, label=\"Predicted Price\")\nplt.legend()\nplt.show()\n\n\n##Predictions\npreds = model.predict(X_test)\npreds_rescaled = scaler.inverse_transform(preds)\ny_test_rescaled = scaler.inverse_transform(y_test.reshape(-1, 1))\n\n# Compute MSE\nmse = mean_squared_error(y_test_rescaled, preds_rescaled)\nprint(f\"Final Test MSE: {mse:.4f}\")\n\n# ------------------------\n# 5b. Plot training & validation MSE\n# ------------------------\nplt.figure(figsize=(8, 5))\nplt.plot(history.history[\"loss\"], label=\"Training MSE\")\nplt.plot(history.history[\"val_loss\"], label=\"Validation MSE\")\nplt.title(\"Model Training vs Validation MSE\")\nplt.xlabel(\"Epoch\")\nplt.ylabel(\"Mean Squared Error\")\nplt.legend()\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-13T06:40:03.269705Z","iopub.status.idle":"2025-11-13T06:40:03.270096Z","shell.execute_reply.started":"2025-11-13T06:40:03.269871Z","shell.execute_reply":"2025-11-13T06:40:03.269884Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"X_train.shape","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-13T06:40:03.270933Z","iopub.status.idle":"2025-11-13T06:40:03.271255Z","shell.execute_reply.started":"2025-11-13T06:40:03.271106Z","shell.execute_reply":"20